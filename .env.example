# Copy to .env and fill in verified values. Never commit .env.

# Production origin, e.g. https://bradfabian.com. Enables canonical + absolute Open Graph URLs.
PUBLIC_SITE_URL=

# Public Calendly or Cal.com event URL for the 30-minute introductory call.
# When empty, local dev shows a clearly labeled booking preview; production builds show the fallback.
PUBLIC_BOOKING_URL=

# Verified public inbox for written inquiries.
PUBLIC_CONTACT_EMAIL=

# Set to "true" only for the approved production deploy. Anything else adds noindex and a disallow-all robots.txt.
PUBLIC_ALLOW_INDEXING=false

# Set to "true" to show the sample booking calendar in a production build (staging review only).
PUBLIC_SHOW_BOOKING_PREVIEW=false
