# Optional overrides. Copy to .env for local use, or set in Vercel → Project → Settings → Environment Variables.
# Never commit .env.

# Production origin. On Vercel production deployments this defaults to https://bradfabian.com.
PUBLIC_SITE_URL=

# Calendly event URL. Defaults to https://calendly.com/brad-bradfabian/30min (src/config.ts).
PUBLIC_BOOKING_URL=

# Public inquiry email. Defaults to brad@bradfabian.com (src/config.ts).
PUBLIC_CONTACT_EMAIL=

# Set to "true" in Vercel's Production environment only, once launch is approved.
# Anything else (and every Vercel preview deployment) adds noindex and a disallow-all robots.txt.
PUBLIC_ALLOW_INDEXING=false

# Set to "true" to show the sample booking calendar when no booking URL is configured (staging review only).
PUBLIC_SHOW_BOOKING_PREVIEW=false
