---
const steps = [
  {
    title: 'Start with the business.',
    text: 'Understand your goals, your customers, and what’s getting in the way before recommending a solution.',
  },
  {
    title: 'Connect the moving parts.',
    text: 'Bring people, platforms, and priorities into one practical plan.',
  },
  {
    title: 'Stay close to the work.',
    text: 'Guide the decisions and details that turn a roadmap into progress.',
  },
];
---

<section class="approach page-width" aria-labelledby="approach-heading">
  <div class="approach-inner">
    <div data-reveal>
      <p class="eyebrow">03 / The approach</p>
      <h2 id="approach-heading" class="section-heading approach-heading">
        Understand it.<br />
        Align it.<br />
        Make it happen.
      </h2>
    </div>

    <ol class="steps">
      {
        steps.map((step, index) => (
          <li class="step" data-reveal style={`--reveal-delay: ${index * 120}ms`}>
            <span class="step-number" aria-hidden="true">
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h3 class="step-title">{step.title}</h3>
              <p class="step-text">{step.text}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .approach {
    position: relative;
    background: var(--color-sage);
  }

  .approach::before {
    content: '';
    position: absolute;
    top: 0;
    left: 13%;
    width: 20%;
    height: 2px;
    background: var(--color-coral);
  }

  .approach-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 48px 64px;
    padding: var(--section-y) var(--pad-content);
  }

  .approach-heading {
    font-size: clamp(38px, 3.3vw, 47px);
  }

  .steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .step {
    display: grid;
    grid-template-columns: 42px 1fr;
    padding: 22px 0;
    border-bottom: 1px solid var(--color-divider);
  }

  .step:first-child {
    padding-top: 0;
  }

  .step:last-child {
    border-bottom: 0;
  }

  .step-number {
    padding-top: 6px;
    color: var(--color-coral-ink);
    font-size: 10px;
    font-weight: 700;
  }

  .step-title {
    margin: 0 0 8px;
    font-family: var(--font-sans);
    font-size: clamp(18px, 1.4vw, 20px);
    font-weight: 500;
    letter-spacing: -0.015em;
    line-height: 1.3;
  }

  .step-text {
    margin: 0;
    font-size: 14px;
  }

  @media (max-width: 760px) {
    .approach-inner {
      grid-template-columns: 1fr;
    }

    .approach-heading {
      font-size: 43px;
    }

    .approach::before {
      left: 6%;
      width: 30%;
    }
  }
</style>
