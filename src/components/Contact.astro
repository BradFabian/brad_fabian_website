---
import { site } from '../config';

const email = site.contactEmail;
const subject = 'Project inquiry';
const to = encodeURIComponent(email);
const su = encodeURIComponent(subject);

// Web compose links let visitors write from the email service they actually use.
const providers = email
  ? [
      { label: 'Gmail', href: `https://mail.google.com/mail/?view=cm&fs=1&to=${to}&su=${su}`, external: true },
      { label: 'Outlook', href: `https://outlook.live.com/mail/0/deeplink/compose?to=${to}&subject=${su}`, external: true },
      {
        label: 'Outlook (work or school)',
        href: `https://outlook.office.com/mail/deeplink/compose?to=${to}&subject=${su}`,
        external: true,
      },
      { label: 'Yahoo Mail', href: `https://compose.mail.yahoo.com/?to=${to}&subject=${su}`, external: true },
      { label: 'Default email app', href: `mailto:${email}?subject=${su}`, external: false },
    ]
  : [];
const showSetupNote = !email && import.meta.env.DEV;
---

<section id="contact" class="contact" aria-labelledby="contact-heading">
  <div class="section contact-inner">
    <div data-reveal>
      <p class="eyebrow">05 / Prefer to write?</p>
      <h2 id="contact-heading" class="section-heading contact-heading">
        What’s your<br />
        next move?
      </h2>
      <p class="lede contact-lede">
        A platform decision. A better customer experience. A clearer plan. Tell me what you’re working on.
      </p>
    </div>

    <div class="contact-panel" data-reveal style="--reveal-delay: 150ms">
      {
        email ? (
          <>
            <p class="panel-label" id="email-label">Email</p>
            <details class="email-menu" data-email-menu>
              <summary class="email-trigger" aria-describedby="email-label">
                <span class="email-address">{email}</span>
                <span class="email-hint">
                  Choose your email app <span class="chevron" aria-hidden="true" />
                </span>
              </summary>
              <ul class="email-options">
                {providers.map((provider) => (
                  <li>
                    <a
                      href={provider.href}
                      {...(provider.external ? { target: '_blank', rel: 'noopener' } : {})}
                    >
                      {provider.label}
                      {provider.external && <span class="visually-hidden"> (opens in a new tab)</span>}
                    </a>
                  </li>
                ))}
                <li data-copy-item hidden>
                  <button type="button" data-copy-email={email}>
                    Copy email address
                  </button>
                </li>
              </ul>
            </details>
            <p class="copy-status" data-copy-status role="status" aria-live="polite" />
            <p class="panel-hint">A few lines is plenty: your business, your platform, and what you’d like to change.</p>
          </>
        ) : (
          <>
            <p class="panel-label">Prefer to talk first?</p>
            <p class="panel-hint">The quickest way to start is a 30-minute introductory call.</p>
            <a class="button panel-button" href="#book">
              Book an introductory call
            </a>
            {showSetupNote && (
              <p class="setup-note">Local preview: set PUBLIC_CONTACT_EMAIL to show the verified inquiry email here.</p>
            )}
          </>
        )
      }
    </div>
  </div>
</section>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('[data-email-menu]');

  if (menu) {
    const summary = menu.querySelector('summary')!;
    const copyItem = menu.querySelector<HTMLElement>('[data-copy-item]');
    const copyButton = menu.querySelector<HTMLButtonElement>('[data-copy-email]');
    const status = document.querySelector<HTMLElement>('[data-copy-status]');

    // Copying is only offered where the browser supports it.
    if (copyItem && copyButton && navigator.clipboard) {
      copyItem.hidden = false;
      copyButton.addEventListener('click', async () => {
        const address = copyButton.dataset.copyEmail ?? '';
        try {
          await navigator.clipboard.writeText(address);
          if (status) status.textContent = `Copied ${address} to your clipboard.`;
        } catch {
          if (status) status.textContent = `Couldn’t copy automatically. The address is ${address}.`;
        }
        menu.open = false;
        summary.focus();
      });
    }

    // Close on Escape or when clicking elsewhere.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        summary.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    menu.addEventListener('toggle', () => {
      if (menu.open && status) status.textContent = '';
    });
  }
</script>

<style>
  .contact {
    border-top: 1px solid var(--color-divider);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px 64px;
    align-items: start;
  }

  .contact-heading {
    font-size: clamp(48px, 3.9vw, 55px);
  }

  .contact-lede {
    max-width: 22rem;
    margin-top: 24px;
  }

  .contact-panel {
    padding-top: 6px;
  }

  .panel-label {
    margin: 0 0 6px;
    color: var(--color-teal-deep);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  /* Email address with a provider menu */
  .email-menu {
    position: relative;
    display: inline-block;
    max-width: 100%;
  }

  .email-trigger {
    display: inline-grid;
    gap: 6px;
    max-width: 100%;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--color-coral);
    cursor: pointer;
    list-style: none;
  }

  .email-trigger::-webkit-details-marker {
    display: none;
  }

  .email-address {
    color: var(--color-teal-deep);
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.4vw, 32px);
    letter-spacing: -0.02em;
    line-height: 1.3;
    overflow-wrap: anywhere;
    transition: color 0.4s var(--ease-out);
  }

  .email-trigger:hover .email-address {
    color: var(--color-teal-muted);
  }

  .email-hint {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-slate);
    font-size: 12px;
  }

  .chevron {
    width: 7px;
    height: 7px;
    margin-top: -3px;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg);
    transition: transform 0.4s var(--ease-out);
  }

  .email-menu[open] .chevron {
    margin-top: 3px;
    transform: rotate(-135deg);
  }

  .email-options {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    z-index: 10;
    min-width: 260px;
    margin: 0;
    padding: 8px;
    border: 1px solid var(--color-divider);
    border-radius: var(--radius-card);
    background: var(--color-paper);
    box-shadow: 0 24px 48px -28px rgb(7 62 69 / 0.45);
    list-style: none;
    transform-origin: top left;
  }

  .email-menu[open] .email-options {
    animation: menu-in 0.45s var(--ease-out);
  }

  @keyframes menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px) scale(0.98);
    }
  }

  .email-options a,
  .email-options button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 44px;
    padding: 10px 14px;
    border: 0;
    border-radius: 6px;
    background: transparent;
    color: var(--color-teal-deep);
    font-family: var(--font-sans);
    font-size: 14px;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.25s ease;
  }

  .email-options a:hover,
  .email-options button:hover {
    background: var(--color-sage);
  }

  .email-options li:last-child:not([hidden]) {
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--color-divider);
  }


  .copy-status {
    margin: 12px 0 0;
    color: var(--color-teal-muted);
    font-size: 13px;
  }

  .copy-status:empty {
    display: none;
  }

  .panel-hint {
    max-width: 28rem;
    margin: 18px 0 26px;
    font-size: 14px;
  }

  .panel-button {
    width: 100%;
    max-width: 28rem;
    padding-block: 14px;
  }

  .setup-note {
    max-width: 28rem;
    margin: 16px 0 0;
    padding: 10px 12px;
    border: 1px dashed var(--color-coral-ink);
    color: var(--color-coral-ink);
    font-size: 12px;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .contact-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
