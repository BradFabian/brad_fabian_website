---
import { site } from '../config';

const mailto = site.contactEmail
  ? `mailto:${site.contactEmail}?subject=${encodeURIComponent('Project inquiry')}`
  : '';
const showSetupNote = !site.contactEmail && import.meta.env.DEV;
---

<section id="contact" class="contact" aria-labelledby="contact-heading">
  <div class="section contact-inner">
    <div>
      <p class="eyebrow">05 / Prefer to write?</p>
      <h2 id="contact-heading" class="section-heading contact-heading">
        What’s your<br />
        next move?
      </h2>
      <p class="lede contact-lede">
        A platform decision. A better customer experience. A clearer plan. Tell me what you’re working on.
      </p>
    </div>

    <div class="contact-panel">
      {
        mailto ? (
          <>
            <p class="panel-label">Email</p>
            <a class="email-link" href={mailto}>
              {site.contactEmail}
            </a>
            <p class="panel-hint">
              A few lines is plenty: your business, your platform, and what you’d like to change.
            </p>
            <a class="button panel-button" href={mailto}>
              Write to Brad <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </>
        ) : (
          <>
            <p class="panel-label">Prefer to talk first?</p>
            <p class="panel-hint">The quickest way to start is a 30-minute introductory call.</p>
            <a class="button panel-button" href="#book">
              Book an introductory call <span class="arrow" aria-hidden="true">↗</span>
            </a>
            {showSetupNote && (
              <p class="setup-note">
                Local preview: set PUBLIC_CONTACT_EMAIL to show the verified inquiry email here.
              </p>
            )}
          </>
        )
      }
    </div>
  </div>
</section>

<style>
  .contact {
    border-top: 1px solid var(--color-divider);
  }

  .contact-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 48px 64px;
    align-items: start;
  }

  .contact-heading {
    font-size: clamp(48px, 3.9vw, 55px);
  }

  .contact-lede {
    max-width: 22rem;
    margin-top: 24px;
  }

  .contact-panel {
    padding-top: 6px;
  }

  .panel-label {
    margin: 0 0 6px;
    color: var(--color-teal-deep);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1px;
  }

  .email-link {
    display: inline-block;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--color-coral);
    color: var(--color-teal-deep);
    font-family: var(--font-serif);
    font-size: clamp(22px, 2.4vw, 32px);
    letter-spacing: -0.02em;
    line-height: 1.3;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .email-link:hover {
    color: var(--color-teal-muted);
  }

  .panel-hint {
    max-width: 28rem;
    margin: 18px 0 26px;
    font-size: 14px;
  }

  .panel-button {
    width: 100%;
    max-width: 28rem;
    padding-block: 14px;
  }

  .setup-note {
    max-width: 28rem;
    margin: 16px 0 0;
    padding: 10px 12px;
    border: 1px dashed var(--color-coral-ink);
    color: var(--color-coral-ink);
    font-size: 12px;
    line-height: 1.5;
  }

  @media (max-width: 760px) {
    .contact-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
