---
const year = new Date().getFullYear();
---

<footer class="site-footer page-width">
  <p class="footer-name">Brad Fabian<span aria-hidden="true">.</span></p>
  <p>© {year} Brad Fabian Consulting LLC</p>
  <p class="footer-location">Based in Miami. Built around you.</p>
</footer>

<style>
  .site-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 30px var(--pad-hero) 40px;
    border-top: 1px solid var(--color-divider);
    font-size: 11px;
  }

  .site-footer p {
    margin: 0;
  }

  .footer-name {
    color: var(--color-teal-deep);
    font-family: var(--font-serif);
    font-size: 21px;
    letter-spacing: -0.02em;
  }

  .footer-name span {
    color: var(--color-coral);
  }

  .footer-location {
    letter-spacing: 0.5px;
    text-transform: uppercase;
  }

  @media (max-width: 560px) {
    .site-footer {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
