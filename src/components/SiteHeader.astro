---
import { Image } from 'astro:assets';
import logo from '../assets/brad-fabian-logo-transparent.png';
---

<header class="site-header page-width">
  <a class="brand" href="/" aria-label="Brad Fabian, home">
    <Image
      src={logo}
      alt=""
      widths={[160, 240, 320, 480]}
      sizes="(max-width: 760px) 150px, 232px"
      loading="eager"
      class="brand-logo"
    />
  </a>
  <nav aria-label="Primary">
    <ul class="nav-list">
      <li class="nav-secondary"><a href="#expertise">Expertise</a></li>
      <li class="nav-secondary"><a href="#about">About</a></li>
      <li><a class="button nav-cta" href="#book">Book a call <span class="arrow" aria-hidden="true">↗</span></a></li>
    </ul>
  </nav>
</header>

<style>
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 28px var(--pad-hero) 0;
  }

  .brand {
    display: block;
    flex-shrink: 0;
    border-radius: 2px;
  }

  .brand-logo {
    display: block;
    width: 232px;
    height: auto;
  }

  .nav-list {
    display: flex;
    align-items: center;
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a:not(.button) {
    color: var(--color-teal-deep);
    font-size: 13px;
    text-decoration: none;
    text-underline-offset: 5px;
  }

  .nav-list a:not(.button):hover {
    text-decoration: underline;
    text-decoration-color: var(--color-coral);
  }

  .nav-cta {
    gap: 0.5rem;
    padding-inline: 18px;
  }

  @media (max-width: 760px) {
    .site-header {
      padding-top: 20px;
    }

    .brand-logo {
      width: 150px;
    }

    .nav-list {
      gap: 20px;
    }
  }

  @media (max-width: 560px) {
    .nav-secondary {
      display: none;
    }
  }
</style>
