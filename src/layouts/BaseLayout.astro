---
import '../styles/global.css';
import { site } from '../config';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const canonical = site.url ? new URL(Astro.url.pathname, site.url).href : undefined;
const ogImage = site.url ? new URL('/og-image.png', site.url).href : '/og-image.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {!site.allowIndexing && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#F6F3EC" />

    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Brad Fabian logo" />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  /* ---------- Scroll reveal ---------- */
  // Anything that has entered (or been scrolled past) the lower 92% of the viewport is revealed.
  // Checking positions on scroll, rather than only on intersection, also catches sections
  // skipped over by a fast jump.
  let pending = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
  let queued = false;

  const revealInView = () => {
    queued = false;
    const limit = window.innerHeight * 0.92;
    pending = pending.filter((el) => {
      if (el.getBoundingClientRect().top < limit) {
        el.classList.add('is-revealed');
        return false;
      }
      return true;
    });
    if (!pending.length) {
      window.removeEventListener('scroll', queueReveal);
      window.removeEventListener('resize', queueReveal);
    }
  };

  function queueReveal() {
    if (queued) return;
    queued = true;
    requestAnimationFrame(revealInView);
  }

  if (reduceMotion.matches) {
    pending.forEach((el) => el.classList.add('is-revealed'));
    pending = [];
  } else {
    window.addEventListener('scroll', queueReveal, { passive: true });
    window.addEventListener('resize', queueReveal, { passive: true });
    queueReveal();
  }

  /* ---------- Eased anchor scrolling ---------- */
  const easeInOutQuart = (t: number) => (t < 0.5 ? 8 * t ** 4 : 1 - (-2 * t + 2) ** 4 / 2);
  let frame = 0;

  const scrollToTarget = (target: HTMLElement | null, hash: string) => {
    const start = window.scrollY;
    const offset = target ? parseFloat(getComputedStyle(target).scrollMarginTop) || 0 : 0;
    const end = target ? Math.max(0, target.getBoundingClientRect().top + start - offset) : 0;
    const distance = end - start;

    const finish = () => {
      history.pushState(null, '', hash);
      // Move keyboard focus to the destination without a second jump.
      if (target) {
        if (!target.hasAttribute('tabindex')) target.setAttribute('tabindex', '-1');
        target.focus({ preventScroll: true });
      }
    };

    if (reduceMotion.matches || Math.abs(distance) < 2) {
      window.scrollTo(0, end);
      finish();
      return;
    }

    const duration = Math.min(1400, Math.max(650, Math.abs(distance) * 0.45));
    const startTime = performance.now();
    cancelAnimationFrame(frame);

    const step = (now: number) => {
      const progress = Math.min(1, (now - startTime) / duration);
      window.scrollTo(0, start + distance * easeInOutQuart(progress));
      if (progress < 1) frame = requestAnimationFrame(step);
      else finish();
    };
    frame = requestAnimationFrame(step);
  };

  // A wheel or touch interrupts the animation so the visitor stays in control.
  for (const type of ['wheel', 'touchstart', 'keydown'] as const) {
    window.addEventListener(type, () => cancelAnimationFrame(frame), { passive: true });
  }

  document.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('a[href^="#"]');
    if (!link || event.defaultPrevented || event.metaKey || event.ctrlKey || event.shiftKey) return;
    const hash = link.hash || '#top';
    const target = hash === '#top' ? null : document.querySelector<HTMLElement>(hash);
    if (hash !== '#top' && !target) return;
    event.preventDefault();
    scrollToTarget(target, hash);
  });
</script>

<style>
  .skip-link {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 50;
    padding: 10px 16px;
    background: var(--color-teal-deep);
    color: var(--color-ivory);
    font-size: 13px;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus {
    transform: none;
  }
</style>
